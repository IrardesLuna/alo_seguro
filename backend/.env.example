# Copie este arquivo para "backend/.env" e preencha.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Chave gratuita gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos usados, em ordem, separados por vírgula. Se o primeiro estiver sobrecarregado,
# o sistema tenta o próximo. "-latest" aponta sempre para a versão mais recente.
# Para ver os modelos liberados para sua chave: python -m app.listar_modelos
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Tempo máximo de espera pela IA, em segundos.
GEMINI_TIMEOUT=60

# Quantas análises cada pessoa (IP) pode fazer por minuto.
LIMITE_POR_MINUTO=10

# ---------------- Consulta de vazamentos ----------------
# demo = base local de exemplo (padrão) | hibp = Have I Been Pwned (só e-mail, precisa de chave paga)
FONTE_VAZAMENTOS=demo
# Chave em https://haveibeenpwned.com/API/Key (fica só no servidor)
HIBP_API_KEY=
HIBP_USER_AGENT=AloSeguro-ProjetoAcademico
HIBP_TIMEOUT=10

# A IA explica o resultado em linguagem simples (recebe só nome do incidente, data e tipos de dado).
IA_NO_VAZAMENTO=true

# ---------------- Casos reais (página de moderação admin.html) ----------------
# Arquivo SQLite onde ficam os casos. Fica fora do Git.
# CAMINHO_BANCO=alo_seguro.db
